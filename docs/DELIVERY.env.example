# Optional demo configuration, copy into a private .env and fill blank fields.
# Questions and selected source context will be sent to this Provider.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_ANSWER_THINKING=disabled
LLM_MAX_TOKENS=1600
# The final-answer code explicitly sends temperature 0.1.
LLM_TEMPERATURE=0.2
# Disable network auto retry for bounded demonstrations only.
LLM_MAX_RETRIES=0
LLM_RETRY_TRANSIENT_ONLY=true
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=local_bge_m3
# Fill a local complete model directory or fully cached model identifier.
EMBEDDING_MODEL=
EMBEDDING_OFFLINE=true
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=runtime/embedding_cache
GITLEARN_DB=runtime/data/gitlearn.sqlite
RUNTIME_DATA_DIR=runtime/product
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
