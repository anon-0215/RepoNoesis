{
  "$defs": {
    "SequenceStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "task_type": {
          "enum": [
            "explain_symbol",
            "trace_static_relation",
            "locate_symbol",
            "explain_static_relationship",
            "analyze_change_impact",
            "separate_fact_inference_unknown"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "answer_text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer Text",
          "type": "string"
        },
        "expected_verdict": {
          "enum": [
            "fail",
            "partial",
            "pass"
          ],
          "title": "Expected Verdict",
          "type": "string"
        },
        "expected_state": {
          "enum": [
            "unseen",
            "introduced",
            "practicing",
            "demonstrated",
            "mastered",
            "needs_review"
          ],
          "title": "Expected State",
          "type": "string"
        },
        "expected_adaptation": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Expected Adaptation",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "task_type",
        "answer_text",
        "expected_verdict",
        "expected_state",
        "expected_adaptation"
      ],
      "title": "SequenceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sequence_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,95}$",
      "title": "Sequence Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "repo_id": {
      "title": "Repo Id",
      "type": "string"
    },
    "repository_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Repository Revision",
      "type": "string"
    },
    "target_path": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Path",
      "type": "string"
    },
    "target_symbol": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Symbol",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SequenceStep"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "annotation_status": {
      "const": "agent_curated_pending_human_review",
      "title": "Annotation Status",
      "type": "string"
    }
  },
  "required": [
    "sequence_id",
    "dataset_version",
    "repo_id",
    "repository_revision",
    "target_path",
    "target_symbol",
    "steps",
    "annotation_status"
  ],
  "title": "AdaptiveSequence",
  "type": "object"
}
