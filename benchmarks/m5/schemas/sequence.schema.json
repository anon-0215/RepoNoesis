{
  "$defs": {
    "RelationIdentity": {
      "additionalProperties": false,
      "properties": {
        "relation_type": {
          "enum": [
            "imports",
            "calls",
            "references",
            "defines"
          ],
          "title": "Relation Type",
          "type": "string"
        },
        "source_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_symbol": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Symbol",
          "type": "string"
        },
        "target_path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Path"
        },
        "target_symbol": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Symbol",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "source_path",
        "source_symbol",
        "target_symbol"
      ],
      "title": "RelationIdentity",
      "type": "object"
    },
    "SequenceStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "task_type": {
          "enum": [
            "explain_symbol",
            "trace_static_relation",
            "locate_symbol",
            "explain_static_relationship",
            "analyze_change_impact",
            "separate_fact_inference_unknown"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "answer_text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer Text",
          "type": "string"
        },
        "expected_key_points": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Expected Key Points",
          "type": "array"
        },
        "expected_source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Expected Source Spans",
          "type": "array"
        },
        "expected_relation_edges": {
          "items": {
            "$ref": "#/$defs/RelationIdentity"
          },
          "maxItems": 10,
          "title": "Expected Relation Edges",
          "type": "array"
        },
        "expected_verdict": {
          "enum": [
            "fail",
            "partial",
            "pass"
          ],
          "title": "Expected Verdict",
          "type": "string"
        },
        "expected_state": {
          "enum": [
            "unseen",
            "introduced",
            "practicing",
            "demonstrated",
            "mastered",
            "needs_review"
          ],
          "title": "Expected State",
          "type": "string"
        },
        "expected_adaptation": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Expected Adaptation",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "task_type",
        "answer_text",
        "expected_key_points",
        "expected_source_spans",
        "expected_verdict",
        "expected_state",
        "expected_adaptation"
      ],
      "title": "SequenceStep",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "qualified_symbol": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Qualified Symbol",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "path",
        "qualified_symbol",
        "start_line",
        "end_line",
        "content_hash"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sequence_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,95}$",
      "title": "Sequence Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "repo_id": {
      "title": "Repo Id",
      "type": "string"
    },
    "repository_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Repository Revision",
      "type": "string"
    },
    "target_path": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Path",
      "type": "string"
    },
    "target_symbol": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Symbol",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SequenceStep"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "annotation_provenance": {
      "enum": [
        "agent_assisted_developer_curation",
        "user_confirmed"
      ],
      "title": "Annotation Provenance",
      "type": "string"
    },
    "annotation_status": {
      "enum": [
        "agent_curated_pending_human_review",
        "human_reviewed"
      ],
      "title": "Annotation Status",
      "type": "string"
    },
    "annotation_reviewed_at": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotation Reviewed At"
    },
    "annotation_review_method": {
      "anyOf": [
        {
          "const": "codex_conversation",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotation Review Method"
    },
    "annotation_note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Annotation Note",
      "type": "string"
    }
  },
  "required": [
    "sequence_id",
    "dataset_version",
    "repo_id",
    "repository_revision",
    "target_path",
    "target_symbol",
    "steps",
    "annotation_provenance",
    "annotation_status",
    "annotation_note"
  ],
  "title": "AdaptiveSequence",
  "type": "object"
}
