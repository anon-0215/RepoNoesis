# RepoNoesis Local Product configuration.
# Copy this file to .env in the repository root. Never commit that file.

# Product generation provider. Obtain the Base URL, API key, and current model
# name from the provider's current official documentation/account console.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional final-answer model override; blank inherits LLM_MODEL (Planner unchanged).
LLM_ANSWER_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
# Optional OpenAI-compatible capabilities. Leave blank to omit the field.
# For a provider/model that documents this extension, planner and final-answer
# behavior may be selected independently as enabled or disabled.
LLM_PLANNER_THINKING=
LLM_ANSWER_THINKING=
# Optional DeepSeek-compatible extensions; set only for a supported model.
# Provider max_tokens includes reasoning; AGENT_* limits still bound visible text.
LLM_PLANNER_MAX_GENERATION_TOKENS=
LLM_ANSWER_MAX_GENERATION_TOKENS=
LLM_PLANNER_REASONING_EFFORT=
LLM_ANSWER_REASONING_EFFORT=
# Opt-in example only (not defaults): LLM_ANSWER_MODEL=deepseek-flash,
# LLM_ANSWER_THINKING=enabled, LLM_ANSWER_REASONING_EFFORT=low,
# LLM_ANSWER_MAX_GENERATION_TOKENS=16384. See docs/ANSWER_MODEL_OPTION.md.
# true retries only explicit HTTP 429/5xx, not ambiguous timeouts/network errors.
LLM_RETRY_TRANSIENT_ONLY=false

# Real local BGE-M3. EMBEDDING_MODEL may be an absolute local snapshot path or
# a model ID already present in EMBEDDING_CACHE_DIR. Offline mode forbids download.
EMBEDDING_ENABLED=true
## Wait for local load and first encode during normal startup; do not extend request budgets.
EMBEDDING_STARTUP_TIMEOUT_SECONDS=20
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=auto
EMBEDDING_OFFLINE=true
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=embedding_cache
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Persistent product data and managed public-Git checkouts. Relative paths are
# resolved from the repository root and are covered by .gitignore.
GITLEARN_DB=backend/data/gitlearn.sqlite
RUNTIME_DATA_DIR=backend/data/runtime
GIT_CLONE_TIMEOUT_SECONDS=120
# Optional explicit proxy for managed public-Git clone subprocesses only.
# Accepts only an absolute http:// or https:// proxy URL. The value is never
# returned by the API or written to Git configuration. Leave blank for no proxy.
REPONOESIS_GIT_PROXY=
REPOSITORY_MAX_FILES=2000
REPOSITORY_MAX_FILE_BYTES=1000000
REPOSITORY_MAX_TOTAL_BYTES=50000000

# Local servers. Only VITE_ variables are exposed to browser code.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Legacy GitHub REST importer only. The Local Product public-Git path does not
# accept credentials and does not use this token.
GITHUB_TOKEN=

# legacy preserves existing defaults and fallback behavior. quality opts into
# larger validated bounds; explicit values below override that profile's defaults.
AGENT_BUDGET_PROFILE=legacy
# Optional mandatory BASE count, capped by request evidence_count. quality
# defaults to 5; blank under legacy keeps the request evidence_count behavior.
AGENT_BASE_EVIDENCE_COUNT=
# Existing bounded Agent limits. Values can only stay inside server hard limits.
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_SAME_TOOL_CALLS=3
AGENT_MAX_NO_PROGRESS_STEPS=2
AGENT_TOTAL_DEADLINE_MS=60000
AGENT_TOOL_TIMEOUT_MS=40000
AGENT_FINAL_ANSWER_RESERVE_MS=5000
AGENT_MAX_SEARCH_RESULTS=20
AGENT_MAX_OBSERVATION_BYTES=65536
AGENT_MAX_SOURCE_READ_LINES=200
AGENT_MAX_SOURCE_READ_BYTES=32768
AGENT_MAX_EVIDENCE_CONTEXT_BYTES=49152
AGENT_MAX_PLANNER_TOKENS_PER_STEP=512
AGENT_MAX_TOTAL_PLANNER_TOKENS=2048
AGENT_MAX_FINAL_ANSWER_TOKENS=1600

# Existing relation and learner-state hard-limit reductions.
AGENT_DEFAULT_RELATION_DEPTH=1
AGENT_MAX_RELATION_DEPTH=2
AGENT_MAX_RELATION_SEEDS=8
AGENT_MAX_RELATION_NEIGHBORS=20
AGENT_MAX_RELATION_NODES=64
AGENT_MAX_RELATION_EDGES=128
AGENT_MAX_RELATION_PATHS=24
AGENT_MAX_RELATION_OBSERVATION_BYTES=65536
AGENT_MAX_RELATION_EVIDENCE=16
AGENT_MAX_LEARNING_STATE_ITEMS=16
AGENT_MAX_RECENT_LEARNING_EVENTS=8
AGENT_MAX_LEARNING_PLAN_STEPS=12
AGENT_MAX_LEARNING_CONTEXT_BYTES=16384

# Evaluation-only M5 gates remain disabled and are not product providers.
M5_ALLOW_NETWORK=false
M5_ALLOW_REAL_LLM=false
M5_ALLOW_MODEL_LOAD=false
M5_ALLOW_PAID_EVAL=false
M5_LLM_MODEL_REVISION=provider-managed
M5_EVALUATOR_MODEL=
M5_EVALUATOR_MODEL_REVISION=provider-managed
# Experimental mechanical source supplementation; process opt-in only.
AGENT_DIRECTED_EVIDENCE_ENABLED=false
